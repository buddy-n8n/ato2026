# Demo defaults so "docker compose up -d" works with zero setup.
# These values are PUBLIC and for local demos only. Change ALL of them before you
# expose anything beyond localhost (see "Make it yours" in the README).

# Owner account: n8n creates it on first start, so there is no setup screen.
# Log in with  demo@example.com  /  Ato2026-demo
OWNER_EMAIL=demo@example.com
OWNER_FIRST_NAME=Demo
OWNER_LAST_NAME=User
# bcrypt hash of the password above (single quotes are required because of the $ signs)
OWNER_PASSWORD_HASH='$2a$10$28Ns.jsB7nzsfNB8pQoi6.NdmO/o8MEgG1JSQT2pKq0Y79YKCqhcC'

# Secrets
PG_PASSWORD=demo-only-change-me
N8N_ENCRYPTION_KEY=demo-only-change-me-0123456789abcdef
